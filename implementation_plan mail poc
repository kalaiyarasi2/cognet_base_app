### **Phase 2: Building the Dedicated Adapter (`partner_adapter.py`)**

The adapter is responsible for reading your local files and sending them to the partner's endpoint formatted exactly as specified in their Swagger.

#### [NEW] [partner_adapter.py](file:///c:/Users/Intern/cognet%20full%20app/Sales%20team%20-%20Copy/partner_adapter.py)

```python
import os
import json
import logging
import httpx
from pathlib import Path
from typing import Dict, Any, Optional

logger = logging.getLogger("PartnerAdapter")

class PartnerAdapterClient:
    """
    Client adapter that connects our extraction outputs with Selva Sir's team's API.
    """
    def __init__(self, base_url: str = None, api_key: str = None):
        self.base_url = (base_url or os.getenv("PARTNER_API_BASE_URL", "")).rstrip("/")
        self.api_key = api_key or os.getenv("PARTNER_API_KEY", "")
        self.timeout = float(os.getenv("PARTNER_TIMEOUT_SECONDS", 90.0))

    def _get_headers(self) -> Dict[str, str]:
        headers = {"Accept": "application/json"}
        if self.api_key:
            headers["Authorization"] = f"Bearer {self.api_key}"
        return headers

    async def submit_payload(
        self,
        sender_email: str,
        modifier_name: str,
        email_metadata: Dict[str, Any],
        acord_json_path: Optional[str] = None,
        acord_file_path: Optional[str] = None,
        loss_run_json_path: Optional[str] = None,
        loss_run_file_path: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Gathers:
          1. Metadata (Sender, Modifier, Subject)
          2. ACORD File & JSON
          3. Loss Run File & JSON
        And executes an HTTP POST to the partner endpoint.
        """
        if not self.base_url:
            raise ValueError("PARTNER_API_BASE_URL is not configured in .env")

        # Load ACORD JSON
        acord_data = {}
        if acord_json_path and os.path.exists(acord_json_path):
            with open(acord_json_path, "r", encoding="utf-8") as f:
                acord_data = json.load(f)

        # Load Loss Run JSON
        loss_run_data = {}
        if loss_run_json_path and os.path.exists(loss_run_json_path):
            with open(loss_run_json_path, "r", encoding="utf-8") as f:
                loss_run_data = json.load(f)

        # Construct JSON Metadata
        payload = {
            "submission_metadata": {
                "sender": sender_email,
                "modifier": modifier_name,
                "subject": email_metadata.get("subject", ""),
                "message_id": email_metadata.get("message_id", ""),
                "received_at": email_metadata.get("received_at", ""),
            },
            "acord_json": acord_data,
            "loss_run_json": loss_run_data,
        }

        # Prepare File Attachments for multipart/form-data
        files = []
        file_handles = []
        try:
            if acord_file_path and os.path.exists(acord_file_path):
                fh1 = open(acord_file_path, "rb")
                file_handles.append(fh1)
                files.append(("acord_file", (Path(acord_file_path).name, fh1, "application/pdf")))

            if loss_run_file_path and os.path.exists(loss_run_file_path):
                fh2 = open(loss_run_file_path, "rb")
                file_handles.append(fh2)
                files.append(("loss_run_file", (Path(loss_run_file_path).name, fh2, "application/pdf")))

            # Endpoint path from Swagger
            endpoint_url = f"{self.base_url}/api/v1/insurance/submit"

            async with httpx.AsyncClient(timeout=self.timeout) as client:
                if files:
                    response = await client.post(
                        endpoint_url,
                        headers=self._get_headers(),
                        data={"data": json.dumps(payload)},
                        files=files
                    )
                else:
                    response = await client.post(
                        endpoint_url,
                        headers={**self._get_headers(), "Content-Type": "application/json"},
                        json=payload
                    )

                response.raise_for_status()
                return response.json()

        finally:
            for fh in file_handles:
                try:
                    fh.close()
                except Exception:
                    pass
