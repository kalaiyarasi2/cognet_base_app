```python
import os
import sys
import time
import json
import base64
import asyncio
import logging
from pathlib import Path

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("PartnerMailFlow")

WORKSPACE_DIR = Path(__file__).parent.resolve()
sys.path.insert(0, str(WORKSPACE_DIR))

from dotenv import load_dotenv
load_dotenv(WORKSPACE_DIR / ".env")

from Outlook_Agent.outlook_agent_module import OutlookAgentModule
from partner_adapter import PartnerAdapterClient
from start_flow import run_local_extraction, classifier_extract, load_categories_from_env, DocumentClassifier
from database import poc_db

MONITORED_EMAIL = os.getenv("PARTNER_POC_MONITOR_EMAIL", "default")
POLL_INTERVAL = int(os.getenv("PARTNER_POC_POLL_INTERVAL", 60))
STAGING_DIR = WORKSPACE_DIR / "partner_poc_staging"

async def process_email_submission(email_data: dict, agent: OutlookAgentModule):
    """Executes the full pipeline for one email."""
    # 1. Parse Email Headers
    sender_val = email_data.get("sender") or email_data.get("from") or {}
    sender_email = sender_val.get("emailAddress", {}).get("address", "unknown@sender.com") if isinstance(sender_val, dict) else str(sender_val)
    modifier = MONITORED_EMAIL
    subject = email_data.get("subject", "No Subject")
    message_id = email_data.get("id")
    received_time = email_data.get("receivedDateTime", "")

    logger.info(f"--- [NEW SUBMISSION] From: {sender_email} | Subject: '{subject}' ---")

    # 2. Download Attachments to Staging
    msg_dir = STAGING_DIR / message_id
    msg_dir.mkdir(parents=True, exist_ok=True)
    
    attachments = email_data.get("attachments", [])
    downloaded_files = []
    
    for att in attachments:
        name = att.get("name", "")
        content = att.get("contentBytes")
        if name and content:
            file_path = msg_dir / name
            with open(file_path, "wb") as f:
                f.write(base64.b64decode(content))
            downloaded_files.append(file_path)

    if not downloaded_files:
        logger.warning("Email contains no valid file attachments. Skipping.")
        return

    # 3. Classify and Extract Documents
    categories = load_categories_from_env()
    classifier = DocumentClassifier(categories=categories)

    acord_pdf, acord_json = None, None
    loss_run_pdf, loss_run_json = None, None

    for pdf_path in downloaded_files:
        if not pdf_path.name.lower().endswith(".pdf"):
            continue

        text, pdf_type, rotation = classifier_extract(pdf_path, max_pages=3)
        category, score = classifier.classify(text)
        logger.info(f"File '{pdf_path.name}' -> Classified as: {category} (Score: {score})")

        extract_result = await run_local_extraction(category, pdf_path, text)
        
        cat_upper = category.upper()
        if "ACORD" in cat_upper:
            acord_pdf = str(pdf_path)
            acord_json = extract_result.get("json")
        elif "LOSS" in cat_upper or "CLAIM" in cat_upper:
            loss_run_pdf = str(pdf_path)
            loss_run_json = extract_result.get("json")

    # 4. Dispatch to Partner API
    adapter = PartnerAdapterClient()
    logger.info("Forwarding extracted files and JSONs to Partner API...")

    try:
        response = await adapter.submit_payload(
            sender_email=sender_email,
            modifier_name=modifier,
            email_metadata={
                "subject": subject,
                "message_id": message_id,
                "received_at": received_time
            },
            acord_json_path=acord_json,
            acord_file_path=acord_pdf,
            loss_run_json_path=loss_run_json,
            loss_run_file_path=loss_run_pdf,
        )
        logger.info(f"✅ [SUCCESS] Partner API Response: {response}")

        # 5. Mark Email Read in Outlook
        agent.mark_as_read(message_id)

        # 6. Record Audit in SQLite
        poc_db.log_universal(
            module="PARTNER_POC",
            action="Email Processing & Dispatch",
            file_name=subject,
            status="SUCCESS",
            details=f"Sender: {sender_email} | Result: {json.dumps(response)}",
            processed_by=modifier
        )

    except Exception as e:
        logger.error(f"❌ [ERROR] Partner API dispatch failed: {e}", exc_info=True)
        poc_db.log_universal(
            module="PARTNER_POC",
            action="Email Processing & Dispatch",
            file_name=subject,
            status="FAILED",
            details=f"Error: {str(e)}",
            processed_by=modifier
        )


async def main_loop():
    logger.info(f"Starting Dedicated Partner Mail Monitor on mailbox: {MONITORED_EMAIL}")
    agent = OutlookAgentModule(user_email=MONITORED_EMAIL)

    while True:
        try:
            logger.info("Scanning for unread emails...")
            unread_emails = agent.fetch_unread_emails() or []
            
            if unread_emails:
                logger.info(f"Detected {len(unread_emails)} unread email(s).")
                for email in unread_emails:
                    await process_email_submission(email, agent)
            else:
                logger.info("No unread emails found.")

        except Exception as err:
            logger.error(f"Error in monitor loop: {err}")

        logger.info(f"Sleeping for {POLL_INTERVAL}s...\n")
        await asyncio.sleep(POLL_INTERVAL)

if __name__ == "__main__":
    asyncio.run(main_loop())
```

