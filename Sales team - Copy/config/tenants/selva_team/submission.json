{
  "enabled": true,
  "target_url": "${SELVA_API_URL}",
  "auth": {
    "type": "dynamic_token",
    "token_url": "${SELVA_AUTH_URL}",
    "client_id_env_var": "SELVA_CLIENT_ID",
    "client_secret_env_var": "SELVA_CLIENT_SECRET",
    "token_path": "data.accessToken",
    "expires_in_path": "data.expiresIn",
    "token_type": "Bearer"
  },
  "default_modifier": 1.0,
  "retry_on_500": true,
  "retry_policy": {
    "max_retries": 3,
    "backoff_factor": 1.5,
    "timeout_seconds": 120
  },
  "default_submitter_email": "jabeenaj@cognethro.com",
  "override_sender_email": false,
  "transform_rules": {
    "strip_summary_level_keys": ["policy_number", "carrier_name"],
    "unified_acord_lossrun": true,
    "include_modifier_data": false,
    "inject_metadata": false,
    "_comment": "STRICT WHITELIST: Insurance Claims, Work Compensation, and Experience Modifier POCs are allowed. All other document types are rejected and an exception email is sent.",
    "allowed_poc_engines": [
      "INSURANCE_CLAIMS",
      "WORK_COMPENSATION",
      "EXPERIENCE_MODIFIER"
    ],
    "default_poc_engine": "INSURANCE_CLAIMS",
    "reject_unmatched_poc": true
  },
  "attachments": {
    "include_original_pdfs": true,
    "include_additional_files": false,
    "multipart_file_field": "file",
    "acord_file_field": "acordPdf",
    "loss_runs_file_field": "lossRunsPdf",
    "modifier_file_field": "modifierPdf"
  },
  "failure_notification": {
    "enabled": true,
    "trigger_on_status_codes": [400, 401, 403, 422, 500],
    "notify_email": "jawagarnathst@cognethro.com",
    "attach_merged_json": true,
    "attach_input_pdfs": true,
    "subject_prefix": "[Selva Team]"
  }
}
