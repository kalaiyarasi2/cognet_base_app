{
  "enabled": false,
  "delivery_method": "mail_out",
  "default_modifier": 1.0,
  "retry_on_500": false,
  "default_submitter_email": "",
  "override_sender_email": false,

  "mail_out": {
    "result_recipient_mode": "fixed",
    "result_to": "${WCUW_CLIENT_OUTPUT_EMAIL}",
    "exception_recipient": "${WCUW_EXCEPTIONAL_MAIL}",
    "send_result_even_if_exceptions": true,
    "subject_prefix": "[WCUW]",
    "unified_json_filename": "WCUW_unified_payload.json",
    "attach_outputs": [
      "lossrun_json",
      "acord_json",
      "merged_json",
      "lossrun_excel",
      "acord_excel"
    ],
    "display_sections": [
      {
        "title": "Key Extracted Data — ACORD 130",
        "fields": [
          {
            "label": "Applicant Name",
            "path": "acord.data.demographics.applicantName",
            "fallback_paths": ["opportunity.opportunityName", "acord.demographics.applicantName", "demographics.applicantName"]
          },
          {
            "label": "FEIN",
            "path": "acord.data.demographics.fein",
            "highlight_if_empty": true,
            "fallback_paths": ["acord.demographics.fein", "demographics.fein"]
          },
          {
            "label": "Policy Number",
            "path": "acord.data.priorCarriers.0.policyNumber",
            "fallback_paths": ["acord.data.demographics.policyNumber", "acord.priorCarriers.0.policyNumber", "acord.demographics.policyNumber"]
          },
          {
            "label": "State",
            "path": "acord.data.demographics.mailingState",
            "fallback_paths": ["acord.data.ratingByState.0.state", "acord.data.demographics.wcStates", "acord.demographics.mailingState"]
          },
          {
            "label": "Effective Date",
            "path": "acord.data.demographics.proposedEffectiveDate",
            "fallback_paths": ["acord.demographics.proposedEffectiveDate"]
          }
        ]
      },
      {
        "title": "Key Extracted Data — Loss Run",
        "fields": [
          {
            "label": "Carrier",
            "path": "lossRuns.report_metadata.carrier_name",
            "fallback_paths": ["lossRuns.carrierName", "lossRuns.insurer", "acord.data.priorCarriers.0.carrierName"]
          },
          {
            "label": "Valuation Date",
            "path": "lossRuns.report_metadata.valuation_date",
            "fallback_paths": ["lossRuns.report_metadata.report_created_date", "lossRuns.valuationDate"]
          },
          {
            "label": "Employee Count",
            "path": "acord.data.ratingByState",
            "fallback_paths": ["lossRuns.employee_count", "lossRuns.summary.employee_count"]
          },
          {
            "label": "Total Claims",
            "path": "lossRuns.claimsCount.total",
            "fallback_paths": ["metadata.totalClaims", "lossRuns.total_claims"]
          }
        ]
      },
      {
        "title": "Underwriting Verifications (API Lookups)",
        "fields": [
          {
            "label": "FEIN Search Status",
            "path": "acord.data.verifications.fein_search.status",
            "fallback_paths": ["acord.verifications.fein_search.status"]
          },
          {
            "label": "FEIN Match Company Name",
            "path": "acord.data.verifications.fein_search.data.0.companyName",
            "fallback_paths": ["acord.verifications.fein_search.data.0.companyName"]
          },
          {
            "label": "Secretary of State Standing",
            "path": "acord.data.verifications.secretary_of_state.status",
            "fallback_paths": ["acord.verifications.secretary_of_state.status"]
          },
          {
            "label": "SOS Matched Entity",
            "path": "acord.data.verifications.secretary_of_state.businessName",
            "fallback_paths": ["acord.data.verifications.secretary_of_state.alternativeResults.0.businessName", "acord.verifications.secretary_of_state.businessName"]
          }
        ]
      }
    ]
  },

  "transform_rules": {
    "strip_summary_level_keys": [],
    "unified_acord_lossrun": true,
    "include_tenant_code": true,
    "include_modifier_data": true,
    "clean_metadata_summary": true,
    "inject_metadata": true,
    "opportunity_template": {
      "recordType": "PEO",
      "stage": "First Meeting",
      "closeDate": "${TODAY+60}",
      "estimatedFirstPayrollDate": "${TODAY+60}",
      "opportunityGeneratedBy": "Channel Partner",
      "channelPartner": "TBD",
      "firstMeetingDate": "${TODAY}"
    },
    "email_extraction_rules": {
      "channelPartner": "Broker Name:\\s*([^<\\r\\n]+)"
    },
    "opportunity_field_sources": {
      "opportunityName": "acord.demographics.applicantName"
    },
    "metadata_count_sources": {
      "totalClaims": "lossRuns.claims",
      "totalRatingEntries": "acord.ratingByState",
      "totalLocations": "acord.locations"
    },
    "_comment": "WCUW: Loss Run (INSURANCE) + ACORD 130 (WORK_COMP) dual pipeline.",
    "allowed_poc_engines": [
      "INSURANCE_CLAIMS",
      "WORK_COMPENSATION",
      "EXPERIENCE_MODIFIER"
    ],
    "default_poc_engine": "WORK_COMPENSATION",
    "reject_unmatched_poc": true
  },

  "attachments": {
    "include_original_pdfs": true,
    "include_additional_files": true,
    "multipart_file_field": "file",
    "acord_file_field": "acordPdf",
    "loss_runs_file_field": "lossRunsPdf",
    "modifier_file_field": "modifierPdf"
  },

  "failure_notification": {
    "enabled": true,
    "trigger_on_status_codes": [400, 401, 403, 422, 500],
    "notify_email": "${WCUW_EXCEPTIONAL_MAIL}",
    "attach_merged_json": true,
    "attach_input_pdfs": true,
    "subject_prefix": "[WCUW]"
  }
}
